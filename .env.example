# Modo da API: mock (padrao hackathon offline/demo) | http (backend FastAPI chapahalls/avisai)
EXPO_PUBLIC_API_MODE=http
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_ROTA_ID=1
# Modo de voz: mock (expo-speech + chips) | agora (react-native-agora + Conversational AI)
EXPO_PUBLIC_VOICE_MODE=agora
# Chave nativa Android para Google Maps (usada apenas no build via app.config.ts, fora do bundle JS)
GOOGLE_MAPS_API_KEY_ANDROID=
# Login: mock (SSO do ApiClient) | keycloak (OIDC + PKCE, ver github.com/rodarglobal/rodar-keycloak)
EXPO_PUBLIC_AUTH_MODE=mock
# No celular use o IP da maquina na rede local, ou localhost com: adb reverse tcp:8180 tcp:8180
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/avisai
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=avisai-mobile
